# Shared backend configuration. Copy to .env and fill only the provider you use.
# Atlas is required. Missing/unreachable Atlas stops startup; no local fallback.
MONGODB_URL=
MONGODB_DATABASE=meeting_db
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Explicit provider: gemini, groq, or openai; blank selects the first configured key. Model selection is automatic.
MINUTES_LLM_PROVIDER=
MINUTES_LLM_MODEL=
LLM_MODEL=

MINUTES_STORAGE_MODE=mongodb
MINUTES_ENABLE_VERIFICATION=true
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1
PORT=8000

# Automatic bounded recovery for output truncation
MINUTES_OUTPUT_TOKEN_CEILING=16384
MINUTES_LENGTH_RETRIES=2
MINUTES_CHUNK_TOKENS=2000
