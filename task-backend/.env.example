# Task Backend Configuration
# -------------------------------------------------------------
# LLM Providers (Configure at least one)
# 1. Gemini (Default and recommended if using Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq (Fast open-source inference)
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration:
# Set your MongoDB Atlas connection string (e.g., mongodb+srv://user:pass@cluster.mongodb.net/meeting_db)
# If left blank or unreachable, the backend automatically uses a local JSON file storage fallback.
MONGODB_URL=

# Server Configuration
HOST=127.0.0.1
PORT=8000

